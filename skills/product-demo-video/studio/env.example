# Save as ~/.config/product-demo-video/.env (used for every video), or as .env in your own
# folder. Only add what you use. Keys are read by name; never paste them in chat.

# Logged-in app capture (optional)
APP_URL=
APP_EMAIL=
APP_PASSWORD=

# Voiceover: any one is enough. ElevenLabs is recommended.
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_multilingual_v2
OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_INSTRUCTIONS=Confident, warm product-launch narrator. Natural pace.
GOOGLE_TTS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
